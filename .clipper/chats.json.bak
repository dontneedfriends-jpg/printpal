        "content": "Read electron-app/package.json (lines 1-104 of 104, 2517 bytes)\n  1: {\n  2:   \"name\": \"printpal\",\n  3:   \"version\": \"1.3.0\",\n  4:   \"description\": \"Filament tracker and 3D print cost calculator\",\n  5:   \"homepage\": \"https://github.com/printpal/printpal\",\n  6:   \"author\": {\n  7:     \"name\": \"PrintPAL\",\n  8:     \"email\": \"printpal@example.com\"\n  9:   },\n 10:   \"main\": \"main.js\",\n 11:   \"scripts\": {\n 12:     \"start\": \"electron .\",\n 13:     \"build\": \"electron-builder\",\n 14:     \"build:win\": \"electron-builder --win\",\n 15:     \"build:linux\": \"electron-builder --linux\",\n 16:     \"android:sync\": \"npx cap sync android\",\n 17:     \"android:open\": \"npx cap open android\",\n 18:     \"android:build\": \"cd ../printpal-android && gradlew assembleDebug\"\n 19:   },\n 20:   \"devDependencies\": {\n 21:     \"@capacitor/android\": \"^8.4.0\",\n 22:     \"@capacitor/cli\": \"^8.4.0\",\n 23:     \"@capacitor/core\": \"^8.4.0\",\n 24:     \"electron\": \"^33.0.0\",\n 25:     \"electron-builder\": \"^25.0.0\"\n 26:   },\n 27:   \"build\": {\n 28:     \"appId\": \"com.printpal.app\",\n 29:     \"productName\": \"PrintPAL\",\n 30:     \"directories\": {\n 31:       \"output\": \"dist6\"\n 32:     },\n 33:     \"files\": [\n 34:       \"main.js\",\n 35:       \"preload.js\",\n 36:       \"loading.html\",\n 37:       \"error.html\",\n 38:       \"runner.py\",\n 39:       \"filament-calculator/**/*\",\n 40:       \"!filament-calculator/venv\",\n 41:       \"!filament-calculator/venv/**/*\",\n 42:       \"!filament-calculator/tests\",\n 43:       \"!filament-calculator/tests/**/*\",\n 44:       \"!filament-calculator/**/__pycache__\",\n 45:       \"!filament-calculator/**/__pycache__/**/*\",\n 46:       \"!filament-calculator/**/*.pyc\",\n 47:       \"!filament-calculator/find_ru.py\",\n 48:       \"!filament-calculator/ru_strings.txt\",\n 49:       \"!android-app\",\n 50:       \"!android-app/**/*\",\n 51:       \"!capacitor.config.ts\"\n 52:     ],\n 53:     \"extraResources\": [\n 54:       {\n 55:         \"from\": \"filament-calculator\",\n 56:         \"to\": \"filament-calculator\",\n 57:         \"filter\": [\n 58:           \"**/*\",\n 59:           \"!venv\",\n 60:           \"!venv/**/*\",\n 61:           \"!tests\",\n 62:           \"!tests/**/*\",\n 63:           \"!**/__pycache__\",\n 64:           \"!**/__pycache__/**/*\",\n 65:           \"!**/*.pyc\",\n 66:           \"!find_ru.py\",\n 67:           \"!ru_strings.txt\"\n 68:         ]\n 69:       },\n 70:       {\n 71:         \"from\": \"python\",\n 72:         \"to\": \"python\",\n 73:         \"filter\": [\n 74:           \"**/*\"\n 75:         ]\n 76:       }\n 77:     ],\n 78:     \"asar\": true,\n 79:     \"asarUnpack\": [\n 80:       \"**/python/**/*\",\n 81:       \"**/filament-calculator/**/*\"\n 82:     ],\n 83:     \"win\": {\n 84:       \"target\": [\n 85:         {\n 86:           \"target\": \"portable\",\n 87:           \"arch\": [\n 88:             \"x64\"\n 89:           ]\n 90:         }\n 91:       ],\n 92:       \"icon\": null\n 93:     },\n 94:     \"portable\": {\n 95:       \"artifactName\": \"PrintPAL.exe\"\n 96:     },\n 97:     \"linux\": {\n 98:       \"target\": [\"AppImage\", \"deb\"],\n 99:       \"maintainer\": \"PrintPAL Team <printpal@example.com>\",\n100:       \"category\": \"Utility\"\n101:     }\n102:   }\n103: }\n104: "
